# Copy this file to .env.local and fill in the values. Never commit .env.local.
# These are server-only: none of them is ever sent to the browser.

# Contact form email, sent through Resend (https://resend.com).
# 1. Create a Resend account and an API key.
# 2. Verify your sending domain in Resend.
# 3. Fill in the three values below and restart the server.

# The Resend API key.
RESEND_API_KEY=

# Where contact-form messages are delivered.
CONTACT_EMAIL_TO=

# The sender shown on those emails. Must use the domain verified in Resend,
# for example: FourthWave Website <website@your-domain.com>
CONTACT_EMAIL_FROM=
